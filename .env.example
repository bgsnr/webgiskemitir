# ==============================================================================
# Environment — webgiskemitir (WebGIS Kemitir Tangguh Bencana — Vite + React)
# Salin file ini menjadi `.env` lalu isi token Mapbox asli Anda di `.env`.
# File `.env` diblokir oleh `.gitignore` dan TIDAK BOLEH di-commit ke Git.
# ==============================================================================

# URL Backend API (bekemitir) — sesuaikan dengan PORT di bekemitir/.env (default 3000 atau 3001)
VITE_API_BASE_URL=http://localhost:3000

# Mapbox Public Access Token (berawalan pk.eyJ1...)
# Ambil dari https://console.mapbox.com/account/access-tokens/
# JANGAN PERNAH taruh Mapbox Secret Token (sk....) di frontend!
VITE_MAPBOX_ACCESS_TOKEN=pk.ganti_dengan_public_token_mapbox_anda

# Identitas Aplikasi
VITE_APP_NAME="Kemitir Tangguh Bencana"
